# ============================================================================
# BPB Commercial Platform — environment variables
# ============================================================================
# Grouped by "do I need to touch this right now," not alphabetically — so
# setup means reading five short sections instead of twenty unfamiliar names
# at once. Copy this file to .env for local work; in Railway, the same names
# go under each service's Variables tab (see the notes in group 2).
# ============================================================================


# ----------------------------------------------------------------------------
# 1. REQUIRED — the app won't start without these
# ----------------------------------------------------------------------------

# Create a bot with @BotFather on Telegram, then paste the token it gives you.
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user ID — message @userinfobot to get it, NOT your
# @username. Read exactly ONCE, on first startup, to create the bootstrap
# OWNER admin (Document 4 §S); never read again after that. Get this wrong and
# you lock yourself out of the admin panel on day one, so double-check the
# number before the first deploy.
TELEGRAM_OWNER_ID=

# The public domain your subscription links will use, e.g. https://sub.yourbrand.tld
# Must be a real domain you control, pointed at this Railway service.
SUBSCRIPTION_BASE_URL=


# ----------------------------------------------------------------------------
# 2. AUTO-PROVIDED BY RAILWAY — never type your own value over these in Railway
# ----------------------------------------------------------------------------
# The moment you add the Postgres and Redis plugins to the Railway project,
# Railway injects DATABASE_URL and REDIS_URL itself as "reference variables" —
# you'll see them already populated on the Variables tab. Overwriting them
# manually is the single easiest way to break production, because the app
# then silently points at a database that isn't the one Railway is running.
# The values below exist ONLY so this also runs on your own machine without
# Railway involved at all.
DATABASE_URL=postgresql://user:password@localhost:5432/bpb_platform
REDIS_URL=redis://localhost:6379/0
PORT=8080


# ----------------------------------------------------------------------------
# 3. GENERATE ONCE, KEEP SECRET — each of these needs its OWN random value.
# Never reuse one secret for two of these, and don't invent a value by hand —
# use the command shown. There's no example value here on purpose: a secret
# that ships with the template is the most common way these leak in real
# deployments, so an empty field that forces you to generate one is safer
# than a placeholder that's tempting to leave in place.
# ----------------------------------------------------------------------------

# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# openssl rand -hex 32
JWT_SIGNING_KEY=

# openssl rand -base64 32   (must decode to exactly 32 bytes for AES-256)
CLOUDFLARE_TOKEN_ENCRYPTION_KEY=

# openssl rand -hex 32
NODE_HMAC_SECRET_PEPPER=


# ----------------------------------------------------------------------------
# 4. SAFE DEFAULTS — correct as shipped; only change these if you know why
# ----------------------------------------------------------------------------

# "development" here on purpose, because this file is what gets copied for
# local work. ENVIRONMENT=production belongs only in Railway's own Variables
# tab, set by hand there — never in a file that gets committed to git.
ENVIRONMENT=development

# Same bot as TELEGRAM_BOT_TOKEN above, username only, no @ — used for the
# "Login with Telegram" widget on the web panel (Document 5 §X).
TELEGRAM_LOGIN_WIDGET_BOT_USERNAME=

R2_BUCKET_NAME=bpb-payment-proofs
STARS_ENABLED=false


# ----------------------------------------------------------------------------
# 5. LATER — leave these blank until you're actually on that phase. Nothing
# in Phases 0-4 (Document 6's roadmap) reads them, so an empty value here
# isn't a bug to chase down early — it's just not built yet.
# ----------------------------------------------------------------------------

# Cloudflare R2 — durable backup copy of payment-proof screenshots, added as
# Phase 5 hardening (Telegram's own file_id is enough to review proofs before then).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# A second payment method alongside manual proof — e.g. zarinpal, once added.
# Document 5 §T: this is additive to the payment_attempts.method column, not
# a replacement, so it's safe to leave blank indefinitely.
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_API_KEY=
