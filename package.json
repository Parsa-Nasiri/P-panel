{
  "name": "proxy-platform",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "start": "node apps/api/dist/server.js",
    "dev": "npm -w apps/api run dev",
    "seed": "node packages/database/dist/seed.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.5.4"
  }
}
