# ---- Core ----
NODE_ENV=production
PUBLIC_BASE_URL=https://your-app.up.railway.app   # your Railway domain (used for webhook + sub links)
APP_SECRET=change-me-long-random-secret           # master key for AES-256-GCM secret encryption
NODE_API_SALT=change-me                           # extra domain separation for node HMAC

# ---- Database (reference the Postgres service) ----
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ---- Telegram bot (optional — omit BOT_TOKEN to disable the bot) ----
BOT_TOKEN=123456:ABC...
BOT_MODE=webhook                                  # webhook (default) | polling
BOT_WEBHOOK_SECRET=change-me
ADMIN_TELEGRAM_IDS=111111111                      # comma-separated; first = primary admin

# ---- Optional ----
ENABLE_JOBS=1                                     # set 0 to run this service without background jobs
PORT=3000
