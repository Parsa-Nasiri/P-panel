# ---- Core ----
NODE_ENV=production
PUBLIC_BASE_URL=https://cp.example.com
APP_SECRET=change-me-64-hex-min            # master key for AES-256-GCM secret encryption
NODE_API_SALT=change-me                    # extra domain separation for node HMAC

# ---- Database (Railway PostgreSQL) ----
DATABASE_URL=postgres://user:pass@host:5432/db

# ---- Telegram bot ----
BOT_TOKEN=123456:ABC...
BOT_MODE=webhook                           # webhook | polling
BOT_WEBHOOK_SECRET=change-me
ADMIN_TELEGRAM_IDS=111111111               # comma-separated; first = primary admin

# ---- Control plane modes ----
JOB_MODE=0                                 # worker service runs with JOB_MODE=1
PORT=3000
